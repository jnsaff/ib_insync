"""Type stubs for eventkit (provided by aeventkit)."""

from collections.abc import AsyncIterator, Awaitable, Generator
from typing import Any, Self

NO_VALUE: Any


class Event:
    error_event: Event
    done_event: Event

    def __init__(
        self,
        name: str = ...,
        _with_error_done_events: bool = ...,
    ) -> None: ...
    def name(self) -> str: ...
    def emit(self, *args: Any) -> None: ...
    def __call__(self, *args: Any) -> None: ...
    def emit_threadsafe(self, *args: Any) -> None: ...
    def connect(
        self,
        listener: Any,
        error: Any = ...,
        done: Any = ...,
        keep_ref: bool = ...,
    ) -> Self: ...
    def disconnect(
        self,
        listener: Any,
        error: Any = ...,
        done: Any = ...,
    ) -> None: ...
    def disconnect_obj(self, obj: Any) -> None: ...
    def clear(self) -> None: ...
    def set_done(self) -> None: ...
    def done(self) -> bool: ...
    def value(self) -> Any: ...
    def wait(self) -> Awaitable[Any]: ...
    def aiter(
        self,
        skip_to_last: bool = ...,
        tuples: bool = ...,
    ) -> AsyncIterator[Any]: ...
    def __iadd__(self, listener: Any) -> Self: ...
